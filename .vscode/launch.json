{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GeoInventory：启动本地界面",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "TEMP": "${workspaceFolder}/.tmp",
        "TMP": "${workspaceFolder}/.tmp"
      }
    }
  ]
}
